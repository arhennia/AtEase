# ──────────────────────────────────────────────────────────
# AtEase — Frontend environment variables
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────

# Supabase project (required for auth, database, storage)
# Get these from https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Set to 'true' to load local demo data when Supabase is not configured
# VITE_USE_LOCAL_FIXTURES=true

# ──────────────────────────────────────────────────────────
# Supabase Edge Function secrets (set via `supabase secrets set`)
# These are NOT frontend env vars — configure them in the Supabase dashboard
# under Functions → Secrets, or via the Supabase CLI.
# ──────────────────────────────────────────────────────────

# Razorpay payment integration (required for subscriptions)
# Get test keys from https://dashboard.razorpay.com → Settings → API Keys
#
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
#
# Set to 'true' only when using live (production) Razorpay keys
# RAZORPAY_ALLOW_LIVE=false
#
# Webhook URL to configure in Razorpay dashboard:
#   https://YOUR_PROJECT.supabase.co/functions/v1/razorpay-webhook
# Events to subscribe: payment.captured, payment.failed, order.paid, refund.processed
